{
  "slug": "appointment-booking",
  "name": "Appointment Booking",
  "category": "booking",
  "description": "Let customers book appointments via WhatsApp. Checks availability, confirms bookings, and sends reminders.",
  "icon": "calendar",
  "trigger_phrases": [
    "book appointment",
    "make appointment",
    "schedule appointment",
    "book a slot",
    "available slots",
    "book time",
    "make booking"
  ],
  "keywords": ["book", "appointment", "schedule", "slot", "time", "booking", "reserve"],
  "required_integrations": [],
  "vertical": null,
  "blueprint": {
    "name": "Appointment Booking",
    "description": "Handles appointment scheduling",
    "nodes": [
      {
        "id": "trigger-1",
        "type": "trigger",
        "data": {
          "label": "Message Received",
          "triggerType": "message_received"
        },
        "position": { "x": 250, "y": 50 }
      },
      {
        "id": "condition-1",
        "type": "condition",
        "data": {
          "label": "Booking Request?",
          "conditionType": "intent_match",
          "intent": "booking",
          "keywords": ["book", "appointment", "schedule", "slot"]
        },
        "position": { "x": 250, "y": 150 }
      },
      {
        "id": "action-1",
        "type": "action",
        "data": {
          "label": "Get Service",
          "actionType": "extract_entity",
          "entityType": "service",
          "promptIfMissing": "What service would you like to book?\n\n{{available_services}}"
        },
        "position": { "x": 250, "y": 250 }
      },
      {
        "id": "action-2",
        "type": "action",
        "data": {
          "label": "Get Date",
          "actionType": "extract_entity",
          "entityType": "date",
          "promptIfMissing": "When would you like to come in? You can say things like 'tomorrow', 'next Monday', or a specific date."
        },
        "position": { "x": 250, "y": 350 }
      },
      {
        "id": "action-3",
        "type": "action",
        "data": {
          "label": "Check Availability",
          "actionType": "check_calendar",
          "calendarId": "{{calendar_id}}",
          "date": "{{extracted.date}}",
          "duration": "{{service_duration}}"
        },
        "position": { "x": 250, "y": 450 }
      },
      {
        "id": "condition-2",
        "type": "condition",
        "data": {
          "label": "Slots Available?",
          "conditionType": "data_check",
          "field": "calendar.available_slots",
          "operator": "not_empty"
        },
        "position": { "x": 250, "y": 550 }
      },
      {
        "id": "action-4",
        "type": "action",
        "data": {
          "label": "Show Slots",
          "actionType": "send_message",
          "message": "Great! Here are the available times for {{extracted.date}}:\n\n{{#each calendar.available_slots}}\n{{@index}}. {{this}}\n{{/each}}\n\nPlease reply with the number of your preferred time."
        },
        "position": { "x": 100, "y": 650 }
      },
      {
        "id": "action-5",
        "type": "action",
        "data": {
          "label": "No Availability",
          "actionType": "send_message",
          "message": "I'm sorry, we don't have availability on {{extracted.date}}. Would you like to try another date, or should I check the next available slot?"
        },
        "position": { "x": 400, "y": 650 }
      },
      {
        "id": "action-6",
        "type": "action",
        "data": {
          "label": "Get Time Selection",
          "actionType": "extract_entity",
          "entityType": "slot_selection"
        },
        "position": { "x": 100, "y": 750 }
      },
      {
        "id": "action-7",
        "type": "action",
        "data": {
          "label": "Get Customer Name",
          "actionType": "extract_entity",
          "entityType": "name",
          "promptIfMissing": "Perfect! What name should I book the appointment under?"
        },
        "position": { "x": 100, "y": 850 }
      },
      {
        "id": "action-8",
        "type": "action",
        "data": {
          "label": "Confirm Booking",
          "actionType": "create_booking",
          "service": "{{extracted.service}}",
          "date": "{{extracted.date}}",
          "time": "{{selected_time}}",
          "customerName": "{{extracted.name}}",
          "customerPhone": "{{customer.phone}}"
        },
        "position": { "x": 100, "y": 950 }
      },
      {
        "id": "action-9",
        "type": "action",
        "data": {
          "label": "Send Confirmation",
          "actionType": "send_message",
          "message": "✅ *Booking Confirmed!*\n\n📋 Service: {{extracted.service}}\n📅 Date: {{extracted.date}}\n🕐 Time: {{selected_time}}\n👤 Name: {{extracted.name}}\n\n📍 Address: {{business_address}}\n\nWe'll send you a reminder before your appointment. Reply 'cancel' if you need to cancel."
        },
        "position": { "x": 100, "y": 1050 }
      }
    ],
    "edges": [
      { "id": "e1", "source": "trigger-1", "target": "condition-1" },
      { "id": "e2", "source": "condition-1", "target": "action-1", "sourceHandle": "yes" },
      { "id": "e3", "source": "action-1", "target": "action-2" },
      { "id": "e4", "source": "action-2", "target": "action-3" },
      { "id": "e5", "source": "action-3", "target": "condition-2" },
      { "id": "e6", "source": "condition-2", "target": "action-4", "sourceHandle": "yes" },
      { "id": "e7", "source": "condition-2", "target": "action-5", "sourceHandle": "no" },
      { "id": "e8", "source": "action-4", "target": "action-6" },
      { "id": "e9", "source": "action-6", "target": "action-7" },
      { "id": "e10", "source": "action-7", "target": "action-8" },
      { "id": "e11", "source": "action-8", "target": "action-9" }
    ]
  },
  "variables": [
    {
      "name": "available_services",
      "type": "string",
      "label": "Available Services",
      "description": "List of services customers can book (one per line)",
      "required": true
    },
    {
      "name": "business_address",
      "type": "string",
      "label": "Business Address",
      "description": "Your business address for appointment confirmation",
      "required": true
    },
    {
      "name": "service_duration",
      "type": "number",
      "label": "Default Service Duration",
      "description": "Default appointment duration in minutes",
      "required": true,
      "defaultValue": 60,
      "validation": {
        "min": 15,
        "max": 480,
        "message": "Duration must be between 15 minutes and 8 hours"
      }
    }
  ],
  "configurable_fields": [
    {
      "key": "send_reminder",
      "type": "boolean",
      "label": "Send Reminders",
      "description": "Send appointment reminders 24 hours before",
      "defaultValue": true
    },
    {
      "key": "allow_cancellation",
      "type": "boolean",
      "label": "Allow Cancellation",
      "description": "Let customers cancel via WhatsApp",
      "defaultValue": true
    }
  ]
}
